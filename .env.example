# ShopCore — Environment Variable Reference
# Copy this file to .env for local development.
# In production (Replit or self-hosted), set these as real environment variables.
# Lines marked [REQUIRED in production] will cause a startup failure if absent.
# Lines marked [optional] have safe defaults for local development.

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# [REQUIRED in production] Django secret key. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-me-in-production

# [optional] Comma-separated list of allowed hostnames.
# Default: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# [REQUIRED in production] PostgreSQL connection string.
# Required: the project uses select_for_update() row-level locking and
# PostgreSQL full-text search (to_tsvector) which SQLite cannot emulate.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://shopcore:shopcore@localhost:5432/shopcore

# [optional] Keep database connections alive for N seconds (default: 60).
CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Cache / Redis
# ---------------------------------------------------------------------------

# [optional] Redis connection URL (default: redis://localhost:6379/0).
# Used for: category tree cache, Django cache framework.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------
# Two styles are supported — pick one:
#
# Style 1 — individual Django vars (recommended, especially for Gmail):
#   Set EMAIL_BACKEND and the vars below; EMAIL_URL will be ignored.
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_gmail_app_password   # use a Gmail App Password, not your account password
#
# Style 2 — DSN string (legacy, EMAIL_BACKEND must NOT be set):
#   smtp+tls://user:password@smtp.example.com:587
#   smtp+ssl://user:password@smtp.example.com:465
#   console://  (prints to stdout, never delivers email)
EMAIL_URL=console://

# [optional] The From address for all outgoing email (default: no-reply@shopcore.example).
DEFAULT_FROM_EMAIL=no-reply@yourdomain.example.com

# [optional] SMTP connection timeout in seconds (default: 10).
EMAIL_TIMEOUT=10

# ---------------------------------------------------------------------------
# Frontend / Site
# ---------------------------------------------------------------------------

# [REQUIRED in production] Public URL of the frontend application.
# Used to build absolute links in transactional emails (email verification,
# password reset, etc.).  Must match the origin your users visit.
# Example: https://shop.example.com
FRONTEND_URL=http://localhost:5000

# [optional] Email address that receives contact form submissions.
# Leave blank to disable admin notifications for contact form messages.
# Example: support@yourdomain.example.com
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# [REQUIRED in production] Comma-separated list of allowed frontend origins.
# Default (dev only): http://localhost:3000
# Example: https://shop.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------

# [optional] Access token lifetime in minutes (default: 15).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# [optional] Refresh token lifetime in days (default: 7).
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------

# [optional] Storage backend for user-uploaded files (default: local).
# Supported values:
#   local  — write files to MEDIA_ROOT on the local filesystem
#   s3     — AWS S3          (requires django-storages + AWS_* vars below)
#   gcs    — Google Cloud    (requires django-storages + GCS_* vars below)
#   r2     — Cloudflare R2   (requires django-storages + R2_* vars below)
#
# IMPORTANT: "local" is NOT suitable for multi-instance or ephemeral-disk
# deployments (e.g. Docker without a mounted volume, Replit ephemeral
# containers). Use a cloud backend for production HA deployments.
MEDIA_STORAGE=local

# [optional] Filesystem path where uploaded files are stored (MEDIA_STORAGE=local).
# Default: <project root>/media
# In production, point this at a directory outside the project root on a
# persistent volume and ensure the application user has write permission:
#   chown shopcore:shopcore /var/www/shopcore/media
#   chmod 750 /var/www/shopcore/media
MEDIA_ROOT=/var/www/shopcore/media

# [optional] URL prefix for serving uploaded files (default: /media/).
# When Nginx is configured to serve media directly, this should match the
# Nginx location block prefix (e.g. /media/).
MEDIA_URL=/media/

# --- AWS S3 (MEDIA_STORAGE=s3) -----------------------------------------------
# [required if MEDIA_STORAGE=s3]
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=        # optional CDN domain (e.g. d1234.cloudfront.net)
# AWS_DEFAULT_ACL=private

# --- Google Cloud Storage (MEDIA_STORAGE=gcs) --------------------------------
# [required if MEDIA_STORAGE=gcs]
# GCS_BUCKET_NAME=your-bucket-name
# GCS_DEFAULT_ACL=projectPrivate

# --- Cloudflare R2 (MEDIA_STORAGE=r2) ----------------------------------------
# [required if MEDIA_STORAGE=r2]
# R2_BUCKET_NAME=your-bucket-name
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_DEFAULT_ACL=private

# ---------------------------------------------------------------------------
# Static files
# ---------------------------------------------------------------------------

# [optional] Absolute filesystem path where collectstatic writes files.
# Default: <project root>/staticfiles
STATIC_ROOT=staticfiles

# ---------------------------------------------------------------------------
# Security headers (production defaults shown — override to disable for staging)
# ---------------------------------------------------------------------------

# [optional] Redirect all HTTP → HTTPS (default in production: True).
SECURE_SSL_REDIRECT=True

# [optional] Set Secure flag on session cookie (default in production: True).
SESSION_COOKIE_SECURE=True

# [optional] Set Secure flag on CSRF cookie (default in production: True).
CSRF_COOKIE_SECURE=True
